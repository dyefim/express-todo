{
  "compilerOptions": {
    "noEmit": true,
    "target": "esnext",
    "module": "preserve",
    "allowJs": true,
    "checkJs": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "bundler",
    "types": ["node"]
  },
  "include": ["**/*"],
  "exclude": [
    "node_modules",
    "build",
    "tests",
    "migrations",
    "docs",
    "scripts",
    "files",
    "logs"
  ]
}
